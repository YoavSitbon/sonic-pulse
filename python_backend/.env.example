# Local Qwen service (Ollama default)
MUSIC_AI_BASE_URL=http://127.0.0.1:11434/v1
MUSIC_AI_MODEL=qwen3:8b
# Ollama does not require a key. vLLM/remote services may require one.
MUSIC_AI_API_KEY=
YOUTUBE_API_KEY=

# Chord-CNN-LSTM uses one checkpoint only (s0 by default). Valid values: 0-4.
CHORD_CNN_LSTM_MODEL_INDEX=0
# Set true to load and average all five checkpoints instead.
CHORD_CNN_LSTM_USE_ENSEMBLE=false
# Dynamically quantize LSTM/linear layers to INT8 for lower CPU memory use.
# Set false to run the original FP32 checkpoints.
CHORD_CNN_LSTM_QUANTIZE=true
# Use ONNX artifacts after running models/Chord-CNN-LSTM/export_onnx.py.
# Options: pytorch, onnx, or auto (auto uses ONNX when artifacts exist).
CHORD_CNN_LSTM_RUNTIME=auto
